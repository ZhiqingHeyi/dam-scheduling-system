* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --glass-bg: rgba(8, 18, 45, 0.45);
  --glass-bg-hover: rgba(12, 28, 65, 0.6);
  --glass-border: rgba(0, 200, 255, 0.25);
  --glass-border-hover: rgba(0, 230, 255, 0.5);
  --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  --glass-glow: 0 0 30px rgba(0, 200, 255, 0.12);
  
  --primary-blue: #00c8ff;
  --primary-cyan: #00f0ff;
  --accent-blue: #0080ff;
  --glow-color: rgba(0, 240, 255, 0.5);
  
  --bg-deep: #020617;
  --bg-dark: #051025;
  --bg-card: rgba(6, 20, 50, 0.5);
  
  --text-primary: #ffffff;
  --text-secondary: #a0c4e8;
  --text-muted: #5a7a9a;
  
  --success-glow: rgba(52, 211, 153, 0.25);
  --success-color: #34d399;
  --warning-glow: rgba(250, 204, 21, 0.2);
  --warning-color: #facc15;
  --danger-glow: rgba(248, 113, 113, 0.2);
  --danger-color: #f87171;
  --info-glow: rgba(96, 165, 250, 0.2);
  --info-color: #60a5fa;
  
  --radius-glass: 16px;
  --radius-sm: 8px;
  --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: var(--bg-deep);
  color: var(--text-primary);
  font-size: 14px;
  line-height: 1.6;
  overflow-x: hidden;
  min-height: 100vh;
  
  &::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
      radial-gradient(ellipse 80% 50% at 20% 10%, rgba(0, 200, 255, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse 60% 40% at 80% 80%, rgba(0, 100, 255, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(4, 15, 40, 1) 0%, var(--bg-deep) 100%);
    pointer-events: none;
    z-index: -2;
  }
  
  &::after {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      var(--primary-cyan) 50%, 
      transparent 100%
    );
    opacity: 0.3;
    z-index: 1000;
  }
}

#app {
  min-height: 100vh;
}

.glass-panel {
  position: relative;
  background: linear-gradient(
    145deg,
    rgba(8, 25, 60, 0.5) 0%,
    rgba(4, 15, 40, 0.4) 100%
  );
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-glass);
  box-shadow: 
    var(--glass-shadow),
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    var(--glass-glow);
  padding: 24px;
  height: 100%;
  transition: var(--transition-smooth);
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(0, 200, 255, 0.6) 50%,
      transparent 100%
    );
    opacity: 0.5;
  }
  
  &::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: var(--radius-glass);
    padding: 1px;
    background: linear-gradient(
      145deg,
      rgba(0, 200, 255, 0.2) 0%,
      transparent 40%,
      transparent 60%,
      rgba(0, 150, 255, 0.15) 100%
    );
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  
  &:hover {
    border-color: var(--glass-border-hover);
    box-shadow: 
      0 12px 40px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 0 50px rgba(0, 200, 255, 0.15);
  }
  
  .panel-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(0, 200, 255, 0.15);
    
    .el-icon {
      color: var(--primary-cyan);
      font-size: 18px;
      filter: drop-shadow(0 0 10px var(--glow-color));
    }
    
    span {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
  }
}

.el-input__wrapper,
.el-select .el-input__wrapper,
.el-textarea__inner {
  background: rgba(6, 20, 50, 0.5) !important;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(0, 150, 255, 0.2) !important;
  box-shadow: 
    inset 0 1px 2px rgba(0, 0, 0, 0.3),
    0 0 0 0 transparent !important;
  transition: var(--transition-smooth) !important;
  
  &:hover {
    border-color: rgba(0, 200, 255, 0.4) !important;
    box-shadow: 
      inset 0 1px 2px rgba(0, 0, 0, 0.3),
      0 0 15px rgba(0, 200, 255, 0.1) !important;
  }
  
  &.is-focus,
  &:focus {
    border-color: var(--primary-cyan) !important;
    box-shadow: 
      inset 0 1px 2px rgba(0, 0, 0, 0.3),
      0 0 25px rgba(0, 240, 255, 0.2),
      0 0 0 2px rgba(0, 240, 255, 0.1) !important;
  }
}

.el-input__inner,
.el-textarea__inner {
  color: var(--text-primary) !important;
  font-size: 13px;
  
  &::placeholder {
    color: var(--text-muted) !important;
  }
}

.el-form-item__label {
  color: var(--text-secondary) !important;
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.el-button--primary {
  background: linear-gradient(135deg, #0080ff 0%, #00c8ff 50%, #00f0ff 100%) !important;
  border: none !important;
  font-weight: 600;
  letter-spacing: 0.5px;
  position: relative;
  overflow: hidden;
  box-shadow: 
    0 4px 15px rgba(0, 128, 255, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.25),
      transparent
    );
    transition: left 0.5s ease;
  }
  
  &:hover::before {
    left: 100%;
  }
  
  &:hover {
    transform: translateY(-1px);
    box-shadow: 
      0 8px 25px rgba(0, 200, 255, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  
  &:active {
    transform: translateY(0);
  }
}

.el-button--default {
  background: rgba(0, 150, 255, 0.1) !important;
  border: 1px solid rgba(0, 200, 255, 0.25) !important;
  color: var(--primary-cyan) !important;
  backdrop-filter: blur(10px);
  
  &:hover,
  &:focus {
    background: rgba(0, 200, 255, 0.15) !important;
    border-color: var(--primary-cyan) !important;
    box-shadow: 0 0 20px rgba(0, 200, 255, 0.2);
  }
}

.el-checkbox__inner {
  background: rgba(6, 20, 50, 0.5);
  border-color: rgba(0, 150, 255, 0.3);
  backdrop-filter: blur(5px);
  
  &:hover {
    border-color: var(--primary-cyan);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.25);
  }
}

.el-checkbox__label {
  color: var(--text-primary);
  font-size: 13px;
}

.el-slider__runway {
  background: rgba(0, 150, 255, 0.12);
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.4);
}

.el-slider__bar {
  background: linear-gradient(90deg, #0080ff, #00f0ff);
  box-shadow: 0 0 12px rgba(0, 240, 255, 0.5);
}

.el-slider__button {
  border-color: var(--primary-cyan);
  background: linear-gradient(135deg, #0080ff, #00f0ff);
  box-shadow: 
    0 0 15px rgba(0, 240, 255, 0.6),
    0 2px 8px rgba(0, 0, 0, 0.3);
}

.el-divider {
  border-color: rgba(0, 150, 255, 0.12);
  
  .el-divider__text {
    color: var(--text-muted);
    font-size: 11px;
    background: var(--bg-card);
    letter-spacing: 1px;
  }
}

.el-date-editor {
  width: 100%;
  
  .el-input__wrapper {
    background: rgba(6, 20, 50, 0.5) !important;
  }
}

.scrollbar-tech {
  &::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  
  &::-webkit-scrollbar-track {
    background: rgba(6, 20, 50, 0.3);
    border-radius: 3px;
  }
  
  &::-webkit-scrollbar-thumb {
    background: linear-gradient(
      180deg,
      rgba(0, 150, 255, 0.5),
      rgba(0, 240, 255, 0.35)
    );
    border-radius: 3px;
    
    &:hover {
      background: linear-gradient(
        180deg,
        rgba(0, 150, 255, 0.7),
        rgba(0, 240, 255, 0.55)
      );
    }
  }
}
