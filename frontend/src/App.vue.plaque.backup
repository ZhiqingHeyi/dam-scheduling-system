<template>
  <div class="app-container">
    <header class="glass-header">
      <div class="header-inner">
        <!-- 左侧：装饰线条 + 状态信息 -->
        <div class="header-left">
          <div class="deco-line left-line">
            <div class="deco-glow"></div>
          </div>
          <div class="status-pill">
            <span :class="['pulse-dot', isConnected ? 'online' : 'offline']"></span>
            <span>{{ isConnected ? '系统在线' : '离线' }}</span>
          </div>
        </div>
        
        <!-- 中间：主标题 -->
        <div class="header-center">
          <h1 class="main-title">QBT水利枢纽工程智能排仓系统</h1>
          <div class="title-glow"></div>
        </div>
        
        <!-- 右侧：时间 + 装饰线条 -->
        <div class="header-right">
          <div class="clock-display">
            {{ currentTime }}
          </div>
          <div class="deco-line right-line">
            <div class="deco-glow"></div>
          </div>
        </div>
      </div>
    </header>
    
    <main class="app-main">
      <router-view v-slot="{ Component }">
        <transition name="glass-fade" mode="out-in">
          <component :is="Component" />
        </transition>
      </router-view>
    </main>
    
    <footer class="glass-footer">
      <p>© 2026 智能建造实验室 · 拱坝施工智能调度平台</p>
      <div class="footer-line"></div>
    </footer>
  </div>
</template>

<script setup lang="ts">
import { ref, onMounted, onUnmounted } from 'vue'

const isConnected = ref(true)
const currentTime = ref('')

let timer: number

const updateTime = () => {
  const now = new Date()
  currentTime.value = now.toLocaleString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  })
}

onMounted(() => {
  updateTime()
  timer = window.setInterval(updateTime, 1000)
})

onUnmounted(() => {
  if (timer) clearInterval(timer)
})
</script>

