.dashboard-container {
  height: calc(100vh - 140px);
  overflow: hidden;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 320px 1fr 360px;
  gap: 20px;
  height: 100%;
  
  .left-panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    padding-right: 6px;
    
    &::-webkit-scrollbar {
      width: 4px;
    }
    
    &::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, rgba(56,189,248,0.4), rgba(34,211,238,0.3));
      border-radius: 2px;
    }
  }
  
  .center-panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    padding: 0 8px;
    
    &::-webkit-scrollbar {
      width: 4px;
    }
    
    &::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, rgba(56,189,248,0.4), rgba(34,211,238,0.3));
      border-radius: 2px;
    }
  }
  
  .right-panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    padding-left: 6px;
    
    &::-webkit-scrollbar {
      width: 4px;
    }
    
    &::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, rgba(56,189,248,0.4), rgba(34,211,238,0.3));
      border-radius: 2px;
    }
  }
}

@media (max-width: 1600px) {
  .dashboard-grid {
    grid-template-columns: 280px 1fr 320px;
    gap: 14px;
  }
}
</style>
